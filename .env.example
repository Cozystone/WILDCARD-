# WILDCARD* — the records (C.I.A terminal → /record) run on Supabase.
# Copy to .env.local (or set them in Vercel → Project → Settings → Environment
# Variables) and fill in. Both are public by design: what they can reach is
# decided by row-level security in supabase/migrations. Never put the
# service-role / secret key here — the site does not use it.

# Project URL — Supabase dashboard → Project Settings → API (or `npx supabase status` locally)
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_…). An older project's "anon" key works too:
# set NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
